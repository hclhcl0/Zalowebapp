generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  fullName   String
  role       String   @default("staff")
  createdAt  DateTime @default(now())
  department String?
}

model Follower {
  id             Int              @id @default(autoincrement())
  zaloUserId     String           @unique
  displayName    String?
  avatarUrl      String?
  phone          String?
  followedAt     DateTime         @default(now())
  userType       String           @default("citizen")
  department     String?
  interestGroup  String?
  notes          String?
  cccd           String?
  dob            String?
  fullName       String?
  accessLevel    String           @default("basic")
  lastSeenAt     DateTime?
  miniAppVersion String?
  totalVisits    Int              @default(0)
  appointments   Appointment[]
  sessions       MiniAppSession[]
  testResults    TestResult[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  fullName    String
  phone       String
  dob         String?
  vaccineType String
  appointedAt DateTime
  status      String    @default("pending")
  note        String?
  createdAt   DateTime  @default(now())
  followerId  Int?
  follower    Follower? @relation(fields: [followerId], references: [id])
}

model TestResult {
  id         Int       @id @default(autoincrement())
  fullName   String
  phone      String
  resultCode String    @unique
  content    String
  testedAt   DateTime
  createdAt  DateTime  @default(now())
  followerId Int?
  follower   Follower? @relation(fields: [followerId], references: [id])
}

model MiniAppSession {
  id         Int      @id @default(autoincrement())
  followerId Int
  action     String
  metadata   String?
  createdAt  DateTime @default(now())
  follower   Follower @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@index([followerId])
  @@index([action])
  @@index([createdAt])
}

model ServiceCategory {
  id           Int            @id @default(autoincrement())
  name         String
  order        Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  description  String?
  imageUrl     String?
  pdfUrl       String?
  rawTable     Json?
  priceImages  Json?
  services     ServicePrice[]
}

model ServicePrice {
  id         Int             @id @default(autoincrement())
  name       String
  price      BigInt
  unit       String          @default("lần")
  isActive   Boolean         @default(true)
  updatedAt  DateTime        @updatedAt
  categoryId Int
  createdAt  DateTime        @default(now())
  note       String?
  order      Int             @default(0)
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
}

model NewsArticle {
  id            Int       @id @default(autoincrement())
  title         String
  content       String
  category      String
  coverUrl      String?
  summary       String?
  author        String?   @default("CDC Đà Nẵng")
  zaloArticleId String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

model MessageLog {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  direction  String
  type       String
  content    String?
  rawPayload String?
  receivedAt DateTime @default(now())
}

model StaffZaloLink {
  id           Int      @id @default(autoincrement())
  staffNameRaw String
  staffName    String
  zaloUserId   String   @unique
  department   String?
  phone        String?
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AiKnowledge {
  id                Int      @id @default(autoincrement())
  title             String
  category          String
  content           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  sourceExt         String?
  sourceUrl         String?
  allowedDepartment String?
}

model GeminiApiKey {
  id          Int      @id @default(autoincrement())
  label       String
  apiKey      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  usageCount  Int      @default(0)
  usageTokens Int      @default(0)
}

model GroqApiKey {
  id          Int      @id @default(autoincrement())
  label       String
  apiKey      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  usageCount  Int      @default(0)
  usageTokens Int      @default(0)
}
